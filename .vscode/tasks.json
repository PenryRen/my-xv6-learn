{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "xv6: qemu-gdb CPUS=1",
      "type": "shell",
      "command": "make CPUS=1 qemu-gdb",
      "isBackground": true,
      "problemMatcher": {
        "pattern": [
